{
	"expo": {
		"name": "com.magidacreativestudios.todoist",
		"slug": "com.magidacreativestudios.todoist",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "com.magidacreativestudios.todoist",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/icon.png",
				"backgroundColor": "#ffffff"
			}
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/todoist-logo.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff"
				}
			],
			"expo-sqlite",
			[
				"expo-font",
				{
					"fonts": [
						"node_modules/@expo-google-fonts/comic-relief/400Regular/ComicRelief_400Regular.ttf",
						"node_modules/@expo-google-fonts/comic-relief/700Bold/ComicRelief_700Bold.ttf",
						"node_modules/@expo-google-fonts/lato/100Thin/Lato_100Thin.ttf",
						"node_modules/@expo-google-fonts/lato/100Thin_Italic/Lato_100Thin_Italic.ttf",
						"node_modules/@expo-google-fonts/lato/300Light/Lato_300Light.ttf",
						"node_modules/@expo-google-fonts/lato/300Light_Italic/Lato_300Light_Italic.ttf",
						"node_modules/@expo-google-fonts/lato/400Regular/Lato_400Regular.ttf",
						"node_modules/@expo-google-fonts/lato/400Regular_Italic/Lato_400Regular_Italic.ttf",
						"node_modules/@expo-google-fonts/lato/700Bold/Lato_700Bold.ttf",
						"node_modules/@expo-google-fonts/lato/700Bold_Italic/Lato_700Bold_Italic.ttf",
						"node_modules/@expo-google-fonts/lato/900Black/Lato_900Black.ttf",
						"node_modules/@expo-google-fonts/lato/900Black_Italic/Lato_900Black_Italic.ttf",
						"node_modules/@expo-google-fonts/lato/100Thin/Lato_100Thin.ttf",
						"node_modules/@expo-google-fonts/lato/100Thin_Italic/Lato_100Thin_Italic.ttf"
					]
				}
			],
			"expo-secure-store"
		],
		"experiments": {
			"typedRoutes": true
		}
	}
}
